# Copy this file to .env and change the values for your machine.
# Variables that are already set in the environment take priority over .env.

# IP address to listen on. Use 0.0.0.0 to listen on all interfaces.
HOST=127.0.0.1
PORT=8080

# Serve STATIC_URL from STATIC_DIR. Set to false if a different server (for
# example nginx) sends the static files. Default: true.
# SERVE_STATIC=true
# STATIC_DIR=static

# The URL path of the static files. It must start and end with /. If nginx
# sends the static files, change its `location` to the same path.
# Default: /static/.
# STATIC_URL=/static/

# Read the static files from disk for each request, so changes show without a
# restart, and give templates URLs without a hash ({{#static}}css/style.css{{/static}}
# gives /static/css/style.css). When false, the files are hashed at startup,
# and the URLs have the hash (/static/css/style.3f2a9c1b7d4e.css).
# Default: true for Debug builds, false for release builds.
# RELOAD_STATIC=true

# Destination of `zig build collectstatic`, which copies STATIC_DIR with and
# without the hashed names, for nginx. Run it after each change to the static
# files, then restart the server.
# STATIC_ROOT=/var/www/zig-web/static

# Directory with the *.mustache templates.
# TEMPLATE_DIR=templates

# Read the templates from disk for each request, so changes show without a
# restart. Default: true for Debug builds, false for release builds.
# RELOAD_TEMPLATES=true

# Directory for uploaded files (see src/media.zig). The server must be able
# to write to it, and makes it when it does not exist. In production, nginx
# sends it as MEDIA_URL; use /var/www/zig-web/media (see
# deploy/zig-web.service).
# Default: media.
# MEDIA_DIR=media

# The URL path of the uploaded files. It must start and end with /. If nginx
# sends them, change its `location` to the same path. Default: /media/.
# MEDIA_URL=/media/

# Secret for signing CSRF tokens, at least 32 characters. Create one with
# `openssl rand -base64 48`. Without it, a random key is used, and forms that
# are open during a restart fail one time. Login sessions are in the database
# and do not use it. Keep it out of this file in production (see
# deploy/zig-web.service).
# SECRET_KEY=

# Send cookies only over HTTPS. Default: true for release builds.
# COOKIE_SECURE=true

# Maximum number of password hashes (logins, registrations) at the same time.
# Each one uses 19 MiB of memory for a short time.
# PASSWORD_HASH_CONCURRENCY=2

# MariaDB (optional). Without DATABASE_URL the server runs without a database.
# When the database cannot be reached, the server still starts, and requests
# that need it get 500 until it is back. The URL contains the password, so
# put it in a file that only root can read (see deploy/zig-web.service), not
# in this file. Percent-encode special characters, for example @ as %40.
# TCP connections use TLS and verify the server certificate by default. With
# MariaDB 11.4 or newer, the certificate is verified with the password, so no
# CA file is necessary. Parameters: tls=required|disabled, tls_ca=PATH.
# DATABASE_URL=mariadb://zig_web:PASSWORD@127.0.0.1:3306/zig_web
# DATABASE_URL=mariadb://zig_web:PASSWORD@db.example.com/zig_web?tls_ca=/etc/ssl/db-ca.pem
# With a Unix socket in place of TCP (local, no TLS):
# DATABASE_URL=mariadb://zig_web:PASSWORD@localhost/zig_web?socket=/run/mysqld/mysqld.sock
# DB_POOL_SIZE=8
# DB_POOL_TIMEOUT_MS=5000
# Seconds after which a connection is closed and opened again (0: no limit).
# DB_CONN_MAX_AGE_S=3600

# OpenTelemetry traces (optional), as OTLP/HTTP JSON to a collector, for
# example Grafana Alloy. The spans go to OTEL_EXPORTER_OTLP_ENDPOINT/v1/traces.
# Without it, the server makes no spans. On the Pi, Alloy receives the
# app's spans on port 4319 and stores them in Tempo (see
# deploy/alloy/zig-web.alloy).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4319
# OTEL_SERVICE_NAME=zig-web
