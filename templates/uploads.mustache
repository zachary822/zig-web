{{<base}}
{{$title}}My uploads · zig-web{{/title}}
{{$content}}
  <div class="mx-auto max-w-5xl px-4">
    <div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight">My uploads</h1>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">Upload {{plural}} and copy their links.</p>
    </div>

    {{! A usual form, so the upload also works without JavaScript (see
        src/routes/uploads.zig). htmx turns the button off while it sends the file. }}
    <form method="post" action="/uploads" enctype="multipart/form-data" hx-disable="find button"
          class="mt-8 flex flex-wrap items-center gap-4 rounded-2xl border border-stone-200 bg-white px-5 py-4 shadow-xs dark:border-stone-800 dark:bg-stone-900">
      {{>csrf_field}}
      <label for="file" class="sr-only">File</label>
      <input id="file" name="file" type="file" required accept="{{accept}}"
             class="min-w-0 flex-1 text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-stone-200 file:px-3 file:py-1.5 file:font-medium file:text-stone-800 hover:file:bg-stone-300 dark:file:bg-stone-800 dark:file:text-stone-200">
      <button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700 disabled:opacity-60 dark:bg-amber-400 dark:text-stone-950 dark:hover:bg-amber-300">Upload</button>
      <p class="w-full text-xs text-stone-500 dark:text-stone-400">
        Upload {{accepted}}.
        {{#limits}}The {{plural}} must have at most {{size}}. {{/limits}}
        The metadata of a file (for example the camera and the GPS location of a photo) is removed.
      </p>
    </form>

    {{#has_filters}}
    <nav aria-label="Kinds of uploads" class="mt-8 flex flex-wrap gap-2 text-sm">
      {{#filters}}
      <a href="{{href}}" {{#current}}aria-current="page"{{/current}}
         class="rounded-full border border-stone-300 px-3 py-1 font-medium capitalize hover:bg-stone-100 aria-[current=page]:border-stone-900 aria-[current=page]:bg-stone-900 aria-[current=page]:text-white dark:border-stone-700 dark:hover:bg-stone-800 dark:aria-[current=page]:border-amber-400 dark:aria-[current=page]:bg-amber-400 dark:aria-[current=page]:text-stone-950">{{label}}</a>
      {{/filters}}
    </nav>
    {{/has_filters}}

    {{#has_uploads}}
    <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{#uploads}}
      <li class="flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-xs dark:border-stone-800 dark:bg-stone-900">
        <a href="{{url}}" target="_blank" rel="noopener noreferrer" class="grid aspect-4/3 place-items-center bg-stone-100 dark:bg-stone-800">
          {{#show_inline}}<img src="{{url}}" alt="{{original_name}}" loading="lazy" class="size-full object-contain">{{/show_inline}}
          {{^show_inline}}<span class="rounded-lg border border-stone-300 px-3 py-2 font-mono text-sm uppercase text-stone-500 dark:border-stone-700 dark:text-stone-400">{{extension}}</span>{{/show_inline}}
        </a>
        <div class="flex flex-1 flex-col p-4 text-sm">
          <p class="truncate font-medium" title="{{original_name}}">{{original_name}}</p>
          <p class="mt-0.5 text-stone-500 dark:text-stone-400">{{#details}}{{.}} &middot; {{/details}}{{size}} &middot; {{date}}</p>
          {{! Alpine.js adds the copy button; without it, select the text. }}
          <div x-data="{ copied: false }" class="mt-3 flex gap-2">
            <input type="text" readonly value="{{url}}" aria-label="Link to {{original_name}}" x-ref="link" @focus="$el.select()"
                   class="min-w-0 flex-1 rounded-lg border border-stone-300 bg-stone-50 px-2 py-1 font-mono text-xs dark:border-stone-700 dark:bg-stone-950">
            <button type="button" x-cloak x-text="copied ? 'Copied' : 'Copy'"
                    @click="navigator.clipboard.writeText($refs.link.value).then(() => { copied = true; setTimeout(() => copied = false, 1500) })"
                    class="rounded-lg border border-stone-300 px-3 py-1 text-xs font-medium hover:bg-stone-100 dark:border-stone-700 dark:hover:bg-stone-800">Copy</button>
          </div>
          {{! htmx asks for confirmation; without JavaScript, the form posts
              directly. }}
          <form method="post" action="{{delete_action}}" class="mt-auto pt-3">
            {{>csrf_field}}
            <button type="submit" hx-post="{{delete_action}}" hx-confirm="Delete this file? You cannot undo this."
                    class="text-xs font-medium text-red-700 hover:underline dark:text-red-400">Delete</button>
          </form>
        </div>
      </li>
    {{/uploads}}
    </ul>
    {{/has_uploads}}
    {{^has_uploads}}
    <div class="mt-8 rounded-2xl border border-dashed border-stone-300 px-6 py-16 text-center dark:border-stone-700">
      <p class="font-serif text-xl font-semibold">You have no uploads.</p>
      <p class="mt-2 text-stone-500 dark:text-stone-400">Upload a file above.</p>
    </div>
    {{/has_uploads}}
  </div>
{{/content}}
{{/base}}
